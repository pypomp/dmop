# Bayesian samplers write these continuously or copy them into every chain.
# Commit batch-level source/, reproducibility.json, configs and launch inputs.
# Reviewed checkpoints/reports are explicitly archived; existing tracked data stays tracked.
/code/bayesian/results/**/*safeBackup*
/code/bayesian/results/**/chain*/source/
/code/bayesian/results/**/chain*/checkpoint*.npz
/code/bayesian/results/**/status.json
/code/bayesian/results/**/metrics.json
/code/bayesian/results/**/completion.json
/code/bayesian/results/**/chain*/optimization.npy
/code/bayesian/results/**/chain*/warm_start.npy
/code/bayesian/results/**/chain*/initial.npy
/code/bayesian/results/**/chain*/initial_chol.npy

# Local isolated Python dependencies, GPU isolation and durable run logs.
/code/bayesian/.runtime/

# Automatically generated control comparison awaits visual review before archiving.
/code/bayesian/results/identity-adapt-nuts-v1/comparison/

# Result trees are local by default. Archive verified outputs under artifacts/;
